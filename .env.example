# Copy this file to ".env" (same folder) and fill in your key.
# The .env file is git-ignored and never reaches the browser.

# Required: your Anthropic API key (starts with "sk-ant-").
# Get one at https://console.anthropic.com  →  API Keys  →  Create Key,
# then add a few dollars of credit under Billing.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: which model does the extraction. Defaults to claude-opus-4-8.
# For a much cheaper, fast extractor, set: claude-haiku-4-5
# ANTHROPIC_MODEL=claude-opus-4-8

# Optional: backend port (must match the Vite proxy in vite.config.ts).
# PORT=8787
